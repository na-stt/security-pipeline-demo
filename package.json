{
  "name": "owasp-nodejs-goat",
  "private": true,
  "version": "1.3.0",
  "description": "A tool to learn OWASP Top 10 for node.js developers",
  "main": "server.js",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mongodb": "7.6.0",
    "nunjucks": "3.2.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test .demo/*.test.cjs",
